	(text "GPIO inputs: enable Pi internal pull-ups in firmware.\nNo external resistor arrays fitted. All switches close to GND.\nDebounce 30 ms. Check tactile switch common legs."
		(exclude_from_sim no)
		(at 185 220 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
