	)
	(text "EXTERNAL KEYBOARD: EXACT 1x9 ORDER"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "750ef2f9-c234-52b8-a1bf-dd23f5e20b69")
	)
	(text "MODE / SHUTDOWN - FIRMWARE PENDING\nShort release: next mode. Hold 3 s: graceful shutdown.\nBCM0 is the HAT ID pin. R2 remains DNP initially.\nBefore fitting R2: disable HAT EEPROM probing, leave\nI2C0 unused and enable the shared button handler.\nCheck boot with button held. Switch power off AFTER halt."
		(exclude_from_sim no)
		(at 185 171 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "8fab2aa2-7a95-591b-bd47-64cc6234bccb")
	)
