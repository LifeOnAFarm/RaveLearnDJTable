	(text "SD and GAIN: no carrier connections; retain module defaults.\nSpeaker connects to module SPK+ / SPK- only.\nComplete module retains its onboard passives."
		(exclude_from_sim no)
		(at 185 109 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "12df324d-8938-55a1-a189-6a2acbf14891")
	)
	(text "SHARED I2S\n48 kHz; two 32-bit slots; 64 BCLK/frame.\nBCLK 3.072 MHz. Pi drives both clocks.\nNo INMP/amp data pins tied together."
		(exclude_from_sim no)
		(at 304 201 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "34b55e3c-7861-577a-abad-6923b19beaa8")
	)
	(text "NO CARRIER MUTE CIRCUIT\nU1 pin 7 / BCM4 is unused. U3 SD and GAIN are unconnected.\nComplete Adafruit-compatible module supplies SD bias.\nNo software-controlled amplifier shutdown."
		(exclude_from_sim no)
		(at 175 216 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "40f83fa6-86de-5e72-9e9c-e32fb08a39c6")
	)
	(text "INMP441: COMPLETE SOLDERED MODULE"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "65cf2ad1-bf90-5c1d-8ce2-5ff09893ede0")
	)
	(text "VCC=3.3 V; I2C address 0x36.\nOUT and GPO/PGO are unused.\nNo OTP/programming connection.\nUse existing Pi I2C pull-ups; check\nparallel pull-ups on the module."
