	(text "Rev A0.2: pixel omitted; microphone gets BCM20.\nDo not apply the PCB pinmux/amp changes to the existing toy yet."
		(exclude_from_sim no)
		(at 200 240 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "6210dd11-896c-5963-a71b-2a692d08cb5b")
	)
	(text "USB supply +5 V -> OFF-BOARD SPST SWITCH -> J3 pin 1.\nUSB supply GND -> J3 pin 2 (ground is not switched).\nPi USB power stays disconnected. Turn switch off after OS halt.\nNo reverse-polarity or supply-ORing circuit.\nPi, amp and auxiliary loads share F1/current budget.\nVerify supply, switch, connector and wire ratings."
		(exclude_from_sim no)
		(at 200 192 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "952375e9-f456-5ae3-889e-7a4a1a02621e")
	)
	(text "U1: Pi Zero mechanical outline + mounting holes.\n5 V enters GPIO header; 3.3 V is supplied BY the Pi.\nNo HAT EEPROM. GPIO1 / pin 28 remains unused."
		(exclude_from_sim no)
		(at 25 145 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "bdcaf094-b090-5f30-8052-955dca422219")
	)
